# ----- 投研对话 /chat（Charles + 通义；DASHSCOPE_API_KEY 走系统环境变量）

# ----- MySQL（晨会、龙头候选、单股回测；库为 wucai_trade）
WUCAI_SQL_HOST=localhost
WUCAI_SQL_PORT=3306
WUCAI_SQL_USERNAME=root
WUCAI_SQL_PASSWORD=
WUCAI_SQL_DB=wucai_trade

# ----- 行情/交易工具：qmt | miniqmt | tdx
WUCAI_QMT=qmt
TDX_PATH=
QMT_BASE_URL=http://127.0.0.1:15588
QMT_TOKEN=

# ----- miniQMT（仅 WUCAI_QMT=miniqmt 时的实盘下单路径）
QMT_PATH=
ACCOUNT_ID=
TRADER_DRY_RUN=1

# ----- 告警推送
DINGTALK_WEBHOOK=
WECOM_WEBHOOK=

# Web 监听端口
DASHBOARD_PORT=7865

# 模拟盘历史回放起始日
SIM_HISTORY_START_DATE=2026-04-01
